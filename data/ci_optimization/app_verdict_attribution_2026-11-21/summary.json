      "runs": "path(normalized)=.github/workflows/admission-gate-v2.yml AND event=pull_request AND status=completed AND head_sha in --sha set",
      "checkRuns": "app.id=5795152 AND name=admission-check AND external_id venue=pull_request",
      "excluded": "external_id venue=merge_group(`v1|`)는 out-of-scope로 별도 카운트하며 절대 위반으로 판정하지 않는다.",
      "merge_group": {
        "runs": "path(normalized)=.github/workflows/admission-gate-v2.yml AND event=merge_group AND status=completed AND head_sha in --sha set",
        "checkRuns": "app.id=5795152 AND name=admission-check AND external_id prefix `v1|`",
        "runIdentity": "external_id에 run id가 없으므로 output.summary의 run=/attempt=에서 해소하고 Actions Run API와 교차 대조한다. 해소 불가는 V2-UNRESOLVED → exit 2.",
        "excluded": "external_id prefix `v1p|` (pull_request)는 out-of-scope로 별도 카운트하며 위반으로 판정하지 않는다."
      }
    },
    "invariants": {
      "V1": "check_run.head_sha == external_id head_sha",
      "V2": "external_id의 run 신원을 Actions Run API와 교차 대조: id, run_attempt(필요 시 /attempts/{n}), repo id, head_sha, workflow path, event venue",
      "V3": "적격 run마다 external_id가 그 run을 지목하는 PR-venue check-run이 정확히 1개(대응 관계의 완전성)",
      "V4": "0 <= t(check completed) - t(run completed) <= max_lag. 미완료가 max_lag 초과면 PENDING, run 완료 전 완료되면 PREMATURE",
      "V5": "summary의 run/attempt/evaluated_commit은 일관성 검증용. A: summary run != external_id run, B: evaluated_commit != run head_sha, C: attempt 불일치"
    },
    "coverage": {
      "perSubject": {
        "RESOLVED_CLEAN": "exit 0 + 적격 run >= 1 + 위반 0",
        "RESOLVED_VIOLATION": "exit 1 (위반 >= 1, V2-UNRESOLVED/V4-UNVERIFIABLE 없음)",
        "UNRESOLVED": "exit 2 (적격 run 0, 또는 V2-UNRESOLVED/V4-UNVERIFIABLE 존재)"
      },
      "aggregateFields": [
        "subjects",
        "resolved",
        "unresolved",
        "violations",
        "coverageRatio",
        "perSubject"
      ],
      "resolvedDefinition": "resolved = RESOLVED_CLEAN + RESOLVED_VIOLATION subject 수",
      "violationsDefinition": "violations = RESOLVED_VIOLATION subject 수 (전체 violation 건수가 아니다)",
      "coverageRatio": "resolved/(resolved+unresolved); 분모 0이면 null",
      "resultInvariant": "PASS는 subjects>0, unresolved==0, violations==0일 때만 성립한다. UNRESOLVED subject가 있고 확정 위반이 없으면 PASS 대신 UNVERIFIABLE(exit 2)이다. 확정 위반이 있으면 FAIL(exit 1)이며 unresolved는 그 verdict를 가리지 않는다.",
      "oneExitCode": "한 호출은 exit code 하나만 낸다. SHA별 귀속은 SHA별 호출 또는 coverage.perSubject로 읽는다."
    }
  },
