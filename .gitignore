# ── Language Ban: src/ & tests/ whitelist (AGENTS.md §0.2) ────────────
# Pure allowlist: only .nim, .lean, .nims, .md, .json, .lock, .feature
# Git tracked data files: .json (domain_layout, certificates), .lock (gate policy)
src/**
!src/**/
!src/**/*.nim
!src/generated/build_env.nim.default
!src/**/*.lean
!src/**/*.nims
!src/**/*.json
!src/**/*.lock
# Policy-as-Code modules (Language Ban exception for compile-time policy kernel)
!src/policy/
!src/policy/**/*.nim
tests/**
!tests/**/
!tests/**/*.nim
!tests/**/*.nims
!tests/**/*.md
!tests/specs/*.json
!tests/auto_generated/*.json
!tests/**/*.feature
!tests/**/*.lean
!tests/**/*.lock
# Parse-poison lint boundary fixtures — workflow YAML is the exact file format
# the lint scans (tools/ci/test_workflow_poison_lint.sh consumes them as *.yml)
!tests/fixtures/workflow_poison/*.yml
# Lane-stderr guard fixtures — workflow YAML in the lane idiom the guard scans
# (tools/ci/test_workflow_lane_guard.sh consumes them as *.yml; prereg §8
# amendment 2026-10-15)
!tests/fixtures/workflow_lane_guard/*.yml
# jq data-contract fixtures — verbatim `gh api` GET response bodies (measured
# 2026-11-01) consumed by tools/ci/test_workflow_jq_contracts.sh; capture
# provenance and official-schema basis: capture_manifest.json in the same dir
!tests/fixtures/workflow_jq_contracts/*.json
!tests/fixtures/workflow_jq_contracts/*.jsonl
# Rust subject fixtures — the certified-subset lane consumes real cargo crates
# (LLBC + sources; language-ban exception mirrors tests/fixtures/rust/)
!tests/fixtures/rust/**
# VS-2 external-subject registry fixtures — spec overlay envelopes + subject stub
# (the JSON envelope is the exact document format the loader consumes)
!tests/fixtures/spec_overlays/**
# Ephemeral artifacts (C class) — never committed
tests/specs/branch_coverage.json
# Test artifact directories (generated at runtime, not committed)
tests/mutation/lean/
tests/tmp/
tests/pbt/generated/
tests/generated_code_dump/
tests/recordings/

