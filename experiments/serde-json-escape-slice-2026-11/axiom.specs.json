{
  "schemaVersion": 1,
  "specs": {
    "serde_json::read::is_escape": {
      "post": "result == (ch == 34 || ch == 92 || (including_control_characters && ch < 32))",
      "conditions": [
        "0 <= ch",
        "ch < 256",
        "0 <= including_control_characters",
        "including_control_characters < 2"
      ]
    }
  }
}
