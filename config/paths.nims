# config/paths.nims — Build Metadata, Dependency Injection, Path Switches
# Extracted from config.nims lines 1-67
# Provides: mdInt/mdStr/mdInt64/mdStrArray procs, injectAxiomDependencies, path switches

# Imports (os, strutils, json) are inherited from the orchestrator config.nims

# ── Φ1: Static Build Metadata ────────────────────────────────────────────────
# All build introspection data is pre-generated by bin/build_metadata_generator.
# config.nims reads it via readFile (runtime) — zero gorge() subprocess calls.
# Bootstrap: if metadata doesn't exist, build_metadata_generator must be run first.
const BuildMetadataPath = "src/generated/build_metadata.json"
var buildMetadata {.global.}: JsonNode = nil
if fileExists(BuildMetadataPath):
  try:
    buildMetadata = parseJson(readFile(BuildMetadataPath))
  except CatchableError:
    buildMetadata = nil

proc mdInt*(key: string, default: int = 0): int {.used.} =
  if buildMetadata != nil and buildMetadata.hasKey(key):
    try: return buildMetadata[key].getInt()
    except CatchableError: discard
  default

proc mdStr(key: string, default: string = ""): string =
  if buildMetadata != nil and buildMetadata.hasKey(key):
    try: return buildMetadata[key].getStr()
    except CatchableError: discard
  default

proc mdInt64(key: string, default: int64 = 0): int64 {.used.} =
  if buildMetadata != nil and buildMetadata.hasKey(key):
    try: return buildMetadata[key].getInt().int64
    except CatchableError: discard
  default

proc mdStrArray(key: string): seq[string] =
  result = @[]
  if buildMetadata != nil and buildMetadata.hasKey(key):
    try:
      for item in buildMetadata[key]:
        result.add(item.getStr())
    except CatchableError: discard

proc injectAxiomDependencies*(pkgs: openArray[string]) =
  ## Axiom 선언적 의존성 인젝터
  ## Worktree/toolchain 레이아웃 버그로 유실된 패키지 경로를 결정론적으로 복구합니다.
  ## 새 패키지 추가 시 아래 호출부의 배열에 문자열 한 줄만 추가하면 됩니다.
  let nimblePkgs2 = getEnv("HOME") / ".nimble" / "pkgs2"
  if dirExists(nimblePkgs2):
    for pkg in pkgs:
      for kind, path in walkDir(nimblePkgs2):
        if kind == pcDir and path.extractFilename.startsWith(pkg & "-"):
          switch("path", path)
          break

# [Fundamental] 패키지 경로 오염 발생 시 배열에 문자열 한 줄만 추가
injectAxiomDependencies(["checksums", "ed25519", "fusion", "malebolgia", "nimcrypto"])

switch("path", ".")
switch("path", "src")                    # covers src/verification/solver/* (Phase 3 — solver module root)
switch("path", "tests/gateway")
# tools/에서 shared_types/를 찾을 수 있도록 path 추가
switch("path", "src/shared_types")
switch("path", "tools")
