{
  "schemaVersion": "axiom.trusted-writer-set.v1",
  // TrustedWriterSet (ADR-0022 §4) — the set of workflows allowed to hold
  // `contents: write`. Verdict: ALL workflows with contents:write MUST be
  // exactly this set (⊆ ∧ ⊇ — verified by tools/ci/verify_trusted_writer_set.sh).
  //
  // GHEC re-land (CI=0 삭제 후 복원, 2026-09-24) + PR-1 (2026-09-26):
  //   - admission-check.yml: UNPRIVILEGED B-pinned check producer
  //     (top-level contents: read; NEVER a ledger writer). 트리거 =
  //     workflow_call 단일 (Cutover — org orchestrator admission-gate @SHA).
  //   - certificate-mint.yml: the SOLE privileged publication authority —
  //     the single production ledger publisher (top-level contents: write,
  //     consumed via workflow_call 단일 (Cutover) — admission-gate DAG가
  //     mint의 유일 발화 경로).
  //
  // ③ write boundary 계약 (Plan ③ — Verify 기준, CE[5]):
  //   mint job = B-pinned code만 실행
  //            + H는 data-only input (raw SHA 미사용 — run object + PR API
  //              재검증 + witness provenance 대조로 강제)
  //            + write destination = ledger(refs/heads/axiom/certificates) 한정
  //            + main 직접 mutation = 불가 (M-B 결속: main 변경 정본 행위 =
  //              GitHub native MERGE만 — mint 경로의 refs/heads/main mutation
  //              0건이 기계 판정되는 운영 상태, CE[5]).
  //   contents: write는 repo-wide capability이며 path-level 아님 — "ledger
  //   only"는 계약이며 보장 = (a) B-pinned code + architect CODEOWNER review,
  //   (b) H data-only (위 재검증 체인), (c) M-B 결속 (verify_trusted_writer_set.sh
  //   단일 writer 등식 + mint 코드 검토). 위반 = fail-closed + 작업 실패.
  //
  // trustedWriterWorkflow names the sole trusted writer
  // (certificate-mint.yml); trustedAdmissionWorkflowSha is the git blob sha
  // of the admission workflow whose witness runs this writer trusts
  // (git hash-object .github/workflows/admission-check.yml — content-
  // addressed; updated atomically with any admission-check.yml change,
  // ADR-0022 §5). The mint reads THIS file @B (config/trusted_writer_set.json
  // at PR base) and compares the fetched admission blob@B against this value
  // (certificate-mint.yml step 2a) — fail-closed on any mismatch.
  //
  // NOTE: this file carries full-line `//` documentation comments (like
  // config/executor_authority.json) — the verifier strips them before parsing.
  "trustedWriterWorkflow": ".github/workflows/certificate-mint.yml",
  "trustedAdmissionWorkflowSha": "13bd4e55e9bf8a531d9d608c13d3fc2657478998",
  //
  // DEBT#558 / ADR-0042 split layout: the execution closure records live in
  // config/trusted_checker_closure.json (derived, mutable values; NOT an App-
  // protected path). pathSetDigest anchors their PATH SET here. A value re-
  // anchor inside the anchored set keeps this digest unchanged; adding or
  // removing a path is a trust-surface change and requires an epoch rotation.
  "pathSetDigest": "axiom.trusted-checker-closure.path-set.v1:affaefbd3bf253f14e482e32fd3f89c574be2fd01446247f0bcd06ec2bb2c796"
}
