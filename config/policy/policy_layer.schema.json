// config/policy/policy_layer.schema.json
// Canonical Policy Layer — rules, bindings, decisions, and severity model.
// SSOT: docs/spec/canonical_contract_policy_layer.md §3
// Version: v1.1.0 (Phase C revision chain extension — added revisions schema families,
//   materializedCurrent, freshness fields; existing v1.0.0 keys preserved intact)

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical Policy Layer schemas. Policy defines immutable rules; PolicyBinding applies rules to subjects with justification; DecisionRule computes disposition from Observation × PolicyBinding. Severity is decided exclusively by policy, never by evaluator. Fail-closed on unknown schema version or unsupported disposition. v1.1.0 adds: revisions schema families (policy revision / baseline revision / contract revision reference), materializedCurrent, freshness fields.",
  "title": "Axiom Canonical Policy Layer",
  "description": "Immutable schemas defining the policy layer that sits above the contract layer. Policies evaluate observations against rules and produce dispositions with explicit severity levels.",
  "version": "1.1.0",

  "definitions": {
    "Policy": {
      "type": "object",
      "required": ["policyId", "rule", "severity", "description", "version"],
      "properties": {
        "policyId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,}$",
          "description": "Unique identifier for this policy rule (e.g., DIGEST_MATCH, BUDGET_LIMIT)."
        },
        "rule": {
          "type": "string",
          "enum": ["DIGEST_MATCH", "BUDGET_LIMIT", "ANCHOR_STABLE", "ALLOWLIST_EXEMPT", "SEVERITY_ESCALATION"],
          "description": "The rule type this policy enforces."
        },
        "severity": {
          "type": "string",
          "enum": ["INFO", "WARN", "ERROR"],
          "description": "Severity level assigned by this policy. Evaluator decides metric result only; severity is policy-exclusive."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of what this policy rule checks."
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of this Policy definition."
        }
      },
      "additionalProperties": false
    },
    "PolicyBinding": {
      "type": "object",
      "required": ["bindingId", "policyRef", "subject", "justification", "owner", "createdAt"],
      "properties": {
        "bindingId": {
          "type": "string",
          "pattern": "^BIND-[A-Z0-9]{4,}$",
          "description": "Unique binding identifier (e.g., BIND-BUDG005)."
        },
        "policyRef": {
          "type": "string",
          "description": "Reference to the Policy.id this binding applies."
        },
        "subject": {
          "type": "object",
          "required": ["type"],
          "oneOf": [
            {
              "properties": {
                "type": {"const": "anchor"},
                "anchor": {"$ref": "#/definitions/Anchor"}
              },
              "required": ["anchor"]
            },
            {
              "properties": {
                "type": {"const": "metric"},
                "metricRef": {"type": "string"}
              },
              "required": ["metricRef"]
            }
          ],
          "description": "Subject of this binding: either an Anchor (code element) or a MetricRef (metric spec)."
        },
        "justification": {
          "type": "string",
          "description": "Rationale for why this binding exists. Must reference an ADR or AGENTS.md section."
        },
        "owner": {
          "type": "string",
          "description": "Owner responsible for this binding (person or team identifier)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of binding creation."
        },
        "expires": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Optional expiration timestamp. null = permanent."
        },
        "metadata": {
          "type": "object",
          "description": "Optional arbitrary metadata attached to this binding."
        }
      },
      "additionalProperties": false
    },
    "DecisionRule": {
      "type": "object",
      "required": ["decisionId", "observationRef", "policyBindingRef", "disposition", "evidence"],
      "properties": {
        "decisionId": {
          "type": "string",
          "pattern": "^DEC-[a-f0-9]{32}$",
          "description": "Deterministic SHA-256 prefix of (observationId + bindingId + timestamp)."
        },
        "observationRef": {
          "type": "string",
          "description": "Reference to the Observation being evaluated."
        },
        "policyBindingRef": {
          "type": "string",
          "description": "Reference to the PolicyBinding applied."
        },
        "disposition": {
          "type": "string",
          "enum": ["INFO", "WARN", "ERROR"],
          "description": "Disposition decided exclusively by policy. FAIL-CLOSED: unknown or unsupported values must be treated as ERROR."
        },
        "evidence": {
          "type": "object",
          "required": ["inputHashes", "reproducibleFrom"],
          "properties": {
            "inputHashes": {
              "type": "object",
              "properties": {
                "observation": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "policyBinding": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "repositoryState": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false,
              "description": "SHA-256 hashes of minimal inputs needed to reproduce this decision."
            },
            "reproducibleFrom": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 1,
              "description": "Minimal set of input identifiers (observationId, bindingId, stateHash) sufficient to reproduce the Decision deterministically."
            }
          },
          "additionalProperties": false,
          "description": "Evidence envelope: minimal input set required to reproduce this Decision."
        }
      },
      "additionalProperties": false
    },
    "EvidenceEnvelope": {
      "type": "object",
      "required": ["envelopeId", "decisionId", "inputs", "output", "integrity"],
      "properties": {
        "envelopeId": {
          "type": "string",
          "pattern": "^ENV-[a-f0-9]{32}$",
          "description": "Deterministic SHA-256 prefix of the complete evidence envelope content."
        },
        "decisionId": {
          "type": "string",
          "description": "Reference to the Decision this envelope supports."
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "hash", "type"],
            "properties": {
              "id": {"type": "string"},
              "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "type": {"type": "string", "enum": ["observation", "policy", "binding", "repository_state"]}
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "description": "Complete set of input artifacts referenced by this decision."
        },
        "output": {
          "type": "object",
          "required": ["disposition", "reasoning"],
          "properties": {
            "disposition": {"type": "string", "enum": ["INFO", "WARN", "ERROR"]},
            "reasoning": {"type": "string", "description": "One-line explanation of how the disposition was reached."}
          },
          "additionalProperties": false,
          "description": "The decision output this envelope attests to."
        },
        "integrity": {
          "type": "object",
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": {"type": "string", "enum": ["sha256"]},
            "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          },
          "additionalProperties": false,
          "description": "Integrity digest over the entire envelope content."
        }
      },
      "additionalProperties": false
    },

    "PolicyRevision": {
      "type": "object",
      "description": "A policy revision entry in the revision chain. Each revision carries a payload (PolicyPayload) and zero or more patches that modify the policy state.",
      "required": ["revisionId", "parentRevisionId", "rationale", "evidenceRef", "payload"],
      "properties": {
        "revisionId": {
          "type": "string",
          "pattern": "^policy-rev-[a-z0-9]+$",
          "description": "Unique identifier for this policy revision."
        },
        "parentRevisionId": {
          "type": ["string", "null"],
          "description": "Reference to the parent revision. null for genesis."
        },
        "rationale": {
          "type": "string",
          "description": "Human-readable rationale for this revision."
        },
        "evidenceRef": {
          "type": "string",
          "description": "Reference to the evidence artifact for this revision."
        },
        "payload": {
          "$ref": "#/definitions/PolicyPayload",
          "description": "The PolicyPayload for this revision (full policy state at this point)."
        },
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["op"],
            "properties": {
              "op": {
                "type": "string",
                "enum": ["addRule", "setDefault", "setRule", "revertTo"],
                "description": "Patch operation type."
              },
              "arguments": {
                "type": "object",
                "description": "Operation-specific arguments."
              }
            },
            "additionalProperties": false
          },
          "description": "Patches to apply on top of the parent revision's state."
        },
        "stability": {
          "type": ["object", "null"],
          "description": "Optional stability constraints for this revision. When present, enforces drift-direction and observation-count guards. Omitting stability preserves existing behavior (backward compatible).",
          "properties": {
            "minStableRevisions": {
              "type": "integer",
              "minimum": 1,
              "description": "Minimum number of consecutive revisions that must exhibit the same drift direction before this revision's disposition change takes effect."
            },
            "direction": {
              "type": "string",
              "enum": ["IMPROVEMENT", "REGRESSION", "MAINTAINED"],
              "description": "Drift direction this revision addresses. IMPROVEMENT = metric is getting better (e.g. fewer violations). REGRESSION = metric is getting worse (e.g. more open issues). MAINTAINED = no directional change expected."
            },
            "requiredConsecutiveObservations": {
              "type": "integer",
              "minimum": 1,
              "description": "Number of consecutive observations that must confirm the drift direction before the revision is considered stable."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "BaselineRevision": {
      "type": "object",
      "description": "A baseline revision entry in the revision chain. Each revision carries a BaselinePayload and optional patches.",
      "required": ["revisionId", "parentRevisionId", "rationale", "evidenceRef", "payload"],
      "properties": {
        "revisionId": {
          "type": "string",
          "pattern": "^baseline-rev-[a-z0-9]+$",
          "description": "Unique identifier for this baseline revision."
        },
        "parentRevisionId": {
          "type": ["string", "null"],
          "description": "Reference to the parent revision. null for genesis."
        },
        "rationale": {
          "type": "string",
          "description": "Human-readable rationale for this revision."
        },
        "evidenceRef": {
          "type": "string",
          "description": "Reference to the evidence artifact for this revision."
        },
        "payload": {
          "$ref": "#/definitions/BaselinePayload",
          "description": "The BaselinePayload for this revision."
        },
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["op"],
            "properties": {
              "op": {
                "type": "string",
                "enum": ["setContractRevision", "setPreviousValue", "setNewValue", "revertTo"],
                "description": "Baseline patch operation type."
              },
              "arguments": {
                "type": "object",
                "description": "Operation-specific arguments."
              }
            },
            "additionalProperties": false
          },
          "description": "Patches to apply on top of the parent revision's state."
        }
      },
      "additionalProperties": false
    },

    "ContractRevisionRef": {
      "type": "object",
      "description": "Reference to a contract revision created by the WS1 agent. Never created or edited by this tool — reference only.",
      "required": ["contractRevisionId", "sourcePath"],
      "properties": {
        "contractRevisionId": {
          "type": "string",
          "pattern": "^contract-rev-[a-z0-9]+$",
          "description": "The contract revision ID from config/policy/contract_revisions.json."
        },
        "sourcePath": {
          "type": "string",
          "description": "Path to the contract revisions file."
        }
      },
      "additionalProperties": false
    },

    "PolicyPayload": {
      "type": "object",
      "description": "Policy state payload — defines disposition rules for PASS/DRIFT states.",
      "required": ["policyId", "statusDomain", "defaultDisposition", "rules"],
      "properties": {
        "policyId": {
          "type": "string",
          "description": "Unique policy identifier."
        },
        "statusDomain": {
          "type": "array",
          "items": {"type": "string", "enum": ["PASS", "DRIFT"]},
          "description": "Valid status domain values."
        },
        "defaultDisposition": {
          "type": "string",
          "enum": ["INFO", "WARN", "ERROR"],
          "description": "Default disposition for unknown states (fail-closed: ERROR)."
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["state", "disposition"],
            "properties": {
              "state": {"type": "string", "enum": ["PASS", "DRIFT"]},
              "disposition": {"type": "string", "enum": ["INFO", "WARN", "ERROR"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "BaselinePayload": {
      "type": "object",
      "description": "Baseline state payload — records committed budget snapshot values with contract revision reference.",
      "required": ["metricId", "contractRevision", "subjectScope"],
      "properties": {
        "metricId": {
          "type": "string",
          "description": "Identifier for the baseline metric set."
        },
        "contractRevision": {
          "type": "string",
          "description": "Must reference an id from contract_revisions.json (P0-1: baseline is NOT a Decision input)."
        },
        "subjectScope": {
          "type": "string",
          "description": "Scope of subjects covered by this baseline."
        },
        "previousValue": {
          "type": "string",
          "description": "Previous baseline value (for drift tracking)."
        },
        "newValue": {
          "type": "string",
          "description": "New baseline value after revision."
        },
        "observedEvidenceRef": {
          "type": "string",
          "description": "Reference to the evidence artifact for this baseline observation."
        },
        "records": {
          "type": "object",
          "description": "Per-metric baseline encoder fields incl. contractRevision.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "baseline": {"type": "integer"},
              "target": {"type": "integer"},
              "current": {"type": "integer"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "MaterializedCurrent": {
      "type": "object",
      "description": "Materialized current state of a policy or baseline, produced by applying all patches to the genesis.",
      "required": ["policyId", "defaultDisposition", "rules"],
      "properties": {
        "policyId": {"type": "string"},
        "defaultDisposition": {"type": "string", "enum": ["INFO", "WARN", "ERROR"]},
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "state": {"type": "string"},
              "disposition": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "metricId": {"type": "string"},
        "contractRevision": {"type": "string"},
        "subjectScope": {"type": "string"},
        "currentValue": {"type": "string"}
      },
      "additionalProperties": false
    },

    "Freshness": {
      "type": "object",
      "description": "Freshness metadata for materialized artifacts — indicates whether the committed artifact matches the latest materialized state.",
      "required": ["status", "lastCheckedAt"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["fresh", "STALE"],
          "description": "Whether the committed artifact matches the materialized state."
        },
        "lastCheckedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of the last freshness check."
        },
        "committedPath": {
          "type": "string",
          "description": "Path to the committed artifact that was checked."
        },
        "note": {
          "type": "string",
          "description": "Optional note (e.g., 'run tools/sync_policy to update')."
        }
      },
      "additionalProperties": false
    }
  },

  "allOf": [
    {
      "if": {"properties": {"$ref": {"const": "#/definitions/Policy"}}},
      "then": {"$ref": "#/definitions/Policy"}
    },
    {
      "if": {"properties": {"$ref": {"const": "#/definitions/PolicyBinding"}}},
      "then": {"$ref": "#/definitions/PolicyBinding"}
    },
    {
      "if": {"properties": {"$ref": {"const": "#/definitions/DecisionRule"}}},
      "then": {"$ref": "#/definitions/DecisionRule"}
    },
    {
      "if": {"properties": {"$ref": {"const": "#/definitions/EvidenceEnvelope"}}},
      "then": {"$ref": "#/definitions/EvidenceEnvelope"}
    },
    {
      "if": {"properties": {"$ref": {"const": "#/definitions/PolicyRevision"}}},
      "then": {"$ref": "#/definitions/PolicyRevision"}
    },
    {
      "if": {"properties": {"$ref": {"const": "#/definitions/BaselineRevision"}}},
      "then": {"$ref": "#/definitions/BaselineRevision"}
    },
    {
      "if": {"properties": {"$ref": {"const": "#/definitions/ContractRevisionRef"}}},
      "then": {"$ref": "#/definitions/ContractRevisionRef"}
    },
    {
      "if": {"properties": {"$ref": {"const": "#/definitions/PolicyPayload"}}},
      "then": {"$ref": "#/definitions/PolicyPayload"}
    },
    {
      "if": {"properties": {"$ref": {"const": "#/definitions/BaselinePayload"}}},
      "then": {"$ref": "#/definitions/BaselinePayload"}
    },
    {
      "if": {"properties": {"$ref": {"const": "#/definitions/MaterializedCurrent"}}},
      "then": {"$ref": "#/definitions/MaterializedCurrent"}
    },
    {
      "if": {"properties": {"$ref": {"const": "#/definitions/Freshness"}}},
      "then": {"$ref": "#/definitions/Freshness"}
    }
  ]
}
